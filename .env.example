# Cổng chạy của service
PORT=8000

# Cấu hình Telegram Bot
# 1. Chat với bot @BotFather trên Telegram để tạo bot và lấy Token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 2. Chat ID của bạn hoặc nhóm cần nhận thông báo (lấy ID qua bot @userinfobot)
TELEGRAM_CHAT_ID=-1001234567890

# Tên hiển thị khi Backend gọi /health kiểm tra (Tuỳ chọn)
NOTIFICATION_PROVIDER=telegram
NOTIFICATION_ACCOUNT_NAME=@tikto_bot
